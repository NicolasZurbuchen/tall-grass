-- The 314 main-series abilities. Upstream's other sixty are Pokemon Conquest's, have no effect text
-- and are on no Pokemon, so they are not generated. See GenerateDataset.buildAbilities.
--
-- There is no category, tag or trigger column, and #27 asks for one. Three attempts are recorded in
-- DECISIONS.md, Rejected for now: a classification for abilities; #65 carries what is left to answer.
-- The list screen filters by generation until then.
--
-- There is no foreign key to variantAbility, which holds the other half of the relationship and
-- lives in Variant.sq: this database is generated whole-file from JSON that has already been
-- validated, so a constraint here would catch nothing the generator has not already checked.
CREATE TABLE ability (
    slug        TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    generation  INTEGER NOT NULL,
    -- Both halves of effect_entries, never flavor_text_entries: the effect entries are PokeAPI's own
    -- prose under BSD, and flavour text is verbatim copyrighted game text. See #11.
    -- The short one is the line on a card; the long one is the paragraph under it on the detail.
    shortEffect TEXT NOT NULL,
    effect      TEXT NOT NULL
);

countAbilities:
SELECT count(*) FROM ability;

insertAbility:
INSERT INTO ability(slug, name, generation, shortEffect, effect) VALUES (?, ?, ?, ?, ?);

-- Every ability, for the list. Alphabetical because that is the only order the rows carry that a
-- reader could be looking along: generation groups them, but within a generation upstream's ids are
-- an internal ordering and nothing a card shows.
--
-- `effect` is left out. It averages 205 characters and runs to 1,555, the list draws none of it, and
-- reading all 314 to show the short line would be about 64 KB nobody looks at.
selectAbilities:
SELECT slug, name, generation, shortEffect
FROM ability
ORDER BY name;

-- One ability, every column -- which makes SQLDelight name the result after the table rather than
-- after the query, so the call site imports it aliased. Same as selectMove.
selectAbility:
SELECT slug, name, generation, shortEffect, effect
FROM ability
WHERE slug = ?;

-- Which Pokemon have one ability, for the Known by tab.
--
-- Joined to `variant` rather than stored denormalised, ordered by Dex number, and carrying the types
-- so the tapped card's hero has its colour before it has read anything: all three for the same
-- reasons selectMoveLearners does it, and this is the same shape with isHidden in place of the
-- learn method.
--
-- `cardSlug` is the dex card the Pokemon is reached through, which is not always the Pokemon: only
-- default forms are cards, so Alolan Sandshrew is reached through Sandshrew.
selectAbilityHolders:
SELECT
    v.slug,
    card.slug AS cardSlug,
    v.speciesDexNumber,
    v.name,
    v.artworkUrl,
    t1.typeSlug AS primaryType,
    t2.typeSlug AS secondaryType,
    va.isHidden
FROM variantAbility va
JOIN variant v ON v.slug = va.variantSlug
LEFT JOIN variant card ON card.speciesDexNumber = v.speciesDexNumber AND card.listedInDex = 1
LEFT JOIN variantType t1 ON t1.variantSlug = v.slug AND t1.slot = 1
LEFT JOIN variantType t2 ON t2.variantSlug = v.slug AND t2.slot = 2
WHERE va.abilitySlug = ?
ORDER BY v.speciesDexNumber, v.sortOrder;
