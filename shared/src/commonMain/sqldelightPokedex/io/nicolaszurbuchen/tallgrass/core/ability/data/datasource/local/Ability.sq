-- The 314 main-series abilities. Upstream's other sixty are Pokemon Conquest's, have no effect text
-- and are on no Pokemon, so they are not generated. See GenerateDataset.buildAbilities.
--
-- There is no foreign key to variantAbility, which holds the other half of the relationship and
-- lives in Variant.sq: this database is generated whole-file from JSON that has already been
-- validated, so a constraint here would catch nothing the generator has not already checked.
CREATE TABLE ability (
    slug        TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    generation  INTEGER NOT NULL,
    -- The closed taxonomy a screen filters on, classified at generation time because upstream has no
    -- category field at all. See AbilityCategory.kt and #27.
    category    TEXT NOT NULL,
    -- effect_entries.short_effect, never flavor_text_entries: the short effect is PokeAPI's own
    -- structured summary under BSD, and flavour text is verbatim copyrighted game text. See #11.
    shortEffect TEXT NOT NULL
);

CREATE INDEX abilityByCategory ON ability(category);

countAbilities:
SELECT count(*) FROM ability;

insertAbility:
INSERT INTO ability(slug, name, generation, category, shortEffect) VALUES (?, ?, ?, ?, ?);
