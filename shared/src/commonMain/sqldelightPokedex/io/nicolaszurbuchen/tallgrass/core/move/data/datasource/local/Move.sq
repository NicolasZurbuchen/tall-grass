-- The 919 main-series moves. Upstream's other eighteen are Pokemon XD's Shadow moves and are not
-- generated, on the same grounds as the Conquest abilities.
--
-- The nullable columns are all genuinely absent rather than defaulted: 331 moves inflict no damage,
-- 285 cannot miss, and 93 Generation VIII and IX moves have no effect text upstream has written yet.
-- Both effect fields are PokeAPI's own prose under BSD, never flavor_text_entries. See #11.
CREATE TABLE move (
    slug        TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    generation  INTEGER NOT NULL,
    typeSlug    TEXT NOT NULL,
    -- "physical", "special" or "status".
    damageClass TEXT NOT NULL,
    power       INTEGER,
    accuracy    INTEGER,
    pp          INTEGER,
    priority    INTEGER NOT NULL,
    -- Upstream's target vocabulary: "selected-pokemon", "all-opponents", "user", and thirteen more.
    target      TEXT NOT NULL,
    -- The percentage behind "has a chance to burn the target", which the prose leaves out.
    effectChance INTEGER,
    shortEffect TEXT,
    effect      TEXT
);

CREATE INDEX moveByType ON move(typeSlug);
CREATE INDEX moveByDamageClass ON move(damageClass);

countMoves:
SELECT count(*) FROM move;

insertMove:
INSERT INTO move(slug, name, generation, typeSlug, damageClass, power, accuracy, pp, priority, target, effectChance, shortEffect, effect)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
