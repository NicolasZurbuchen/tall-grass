-- The 919 main-series moves. Upstream's other eighteen are Pokemon XD's Shadow moves and are not
-- generated, on the same grounds as the Conquest abilities.
--
-- The nullable columns are all genuinely absent rather than defaulted: 331 moves inflict no damage,
-- 285 cannot miss, and 93 Generation VIII and IX moves have no effect text upstream has written yet.
-- Both effect fields are PokeAPI's own prose under BSD, never flavor_text_entries. See #11.
CREATE TABLE move (
    slug        TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    generation  INTEGER NOT NULL,
    typeSlug    TEXT NOT NULL,
    -- "physical", "special" or "status".
    damageClass TEXT NOT NULL,
    power       INTEGER,
    accuracy    INTEGER,
    pp          INTEGER,
    priority    INTEGER NOT NULL,
    -- Upstream's target vocabulary: "selected-pokemon", "all-opponents", "user", and thirteen more.
    target      TEXT NOT NULL,
    -- The percentage behind "has a chance to burn the target", which the prose leaves out.
    effectChance INTEGER,
    shortEffect TEXT,
    effect      TEXT,

    -- Upstream's `move_meta`, flattened. Null in every one of these means "nothing to say" rather
    -- than zero, and all twelve are null together for the 92 Generation VIII and IX moves upstream
    -- has not filled in. Reading a null as 0 is wrong in both directions at once: it puts "0% drain"
    -- on 908 moves, and `ailmentChance` is null for the thirty-six whose ailment is *certain* --
    -- Thunder Wave does not paralyse 0% of the time.
    --
    -- Upstream's own fourteen-way split, and the only classification axis in this database that was
    -- not invented: "damage", "ailment", "net-good-stats", "ohko", "unique" and nine more. It is
    -- what the moves list filters on, which is why it is indexed.
    category     TEXT,
    -- "burn", "paralysis", "confusion" and eighteen more, or "unknown" for the four moves whose
    -- ailment genuinely varies.
    ailment      TEXT,
    ailmentChance INTEGER,
    minHits      INTEGER,
    maxHits      INTEGER,
    minTurns     INTEGER,
    maxTurns     INTEGER,
    -- Signed percentages, and the sign is the meaning: drain is a share of the damage dealt and goes
    -- negative for recoil, healing is a share of the user's own maximum HP and goes negative for the
    -- two moves that cost HP to use.
    drain        INTEGER,
    healing      INTEGER,
    -- Stages above the normal critical-hit rate. 6 is the four moves that always crit.
    critRate     INTEGER,
    flinchChance INTEGER,
    statChance   INTEGER
);

-- The stat stages a move moves, signed, at most five per move.
--
-- A sibling of the meta columns rather than part of them, because fifteen moves have stat changes
-- and no meta row: `statChance` can be null while there is still a stat change to draw. A null
-- `statChance` beside rows here means the change is guaranteed, which is 60 of the 174 -- Growl
-- always lowers Attack.
--
-- No ordering column, on the same grounds as `variantStat`: upstream has none, and the caller
-- already knows the order it draws stats in.
CREATE TABLE moveStatChange (
    moveSlug TEXT NOT NULL,
    statSlug TEXT NOT NULL,
    change   INTEGER NOT NULL,
    PRIMARY KEY (moveSlug, statSlug)
);

CREATE INDEX moveByType ON move(typeSlug);
CREATE INDEX moveByDamageClass ON move(damageClass);
CREATE INDEX moveByCategory ON move(category);

countMoves:
SELECT count(*) FROM move;

insertMove:
INSERT INTO move(slug, name, generation, typeSlug, damageClass, power, accuracy, pp, priority, target, effectChance, shortEffect, effect, category, ailment, ailmentChance, minHits, maxHits, minTurns, maxTurns, drain, healing, critRate, flinchChance, statChance)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertMoveStatChange:
INSERT INTO moveStatChange(moveSlug, statSlug, change) VALUES (?, ?, ?);

-- Alphabetical, because a move has no number to walk. The dex is ordered by the National Dex and
-- this is the closest thing a list of 919 names has to it.
selectMoves:
SELECT slug, name, typeSlug, damageClass, power
FROM move
ORDER BY name;

-- Columns named rather than a star, so the generated type is SelectMove and not the table type Move,
-- which would collide with the domain model of the same name in every mapper that touches both.
selectMove:
SELECT slug, name, generation, typeSlug, damageClass, power, accuracy, pp, priority, target,
       shortEffect, effect, category, ailment, ailmentChance, minHits, maxHits, minTurns, maxTurns,
       drain, healing, critRate, flinchChance, statChance
FROM move
WHERE slug = ?;

-- Unordered on purpose. The table has no ordering column and the primary key would hand these back
-- alphabetically, which is not the order stats are drawn in anywhere else in the app. `BattleStat`
-- declares that order and the mapper sorts by it, so there is one statement of it rather than two.
selectMoveStatChanges:
SELECT statSlug, change
FROM moveStatChange
WHERE moveSlug = ?;

-- Which Pokemon learn each move, from each Pokemon's most recent appearance. 46,679 rows.
--
-- One row per Pokemon and move rather than one per way of getting it: a move that is both a level-up
-- move and a TM is one fact on a card, and the generator picks which answer to keep. See
-- DECISIONS.md on the learnset.
--
-- `level` is set only where `method` is 'level-up'. A TM has no level, and 0 would claim it is
-- learned on hatching.
CREATE TABLE moveLearner (
    moveSlug    TEXT NOT NULL,
    variantSlug TEXT NOT NULL,
    -- "level-up", "machine", "egg" or "tutor".
    method      TEXT NOT NULL,
    level       INTEGER,
    PRIMARY KEY (moveSlug, variantSlug)
);

-- The primary key already leads with moveSlug, so the only lookup this table has is covered.
-- A second index on variantSlug is what the Pokemon detail's Moves tab will want, and it is not
-- added until something reads it.

-- Joined to `variant` here rather than stored denormalised: the name and the artwork belong to the
-- Pokemon, and 46,679 copies of a URL is how a dataset gets a row that disagrees with itself.
--
-- Ordered by Dex number so the list reads as a walk through the Pokedex, with a species' forms
-- adjacent -- the same ordering selectDexEntries uses, because it is the same walk.
-- The types come along because tapping one of these opens the Pokemon, and its hero draws the
-- artwork and the colour before it has read anything. LEFT for the same reason selectDexEntries
-- uses LEFT: a subquery would be typed NOT NULL and most Pokemon have no second type.
selectMoveLearners:
SELECT
    v.slug,
    v.speciesDexNumber,
    v.name,
    v.formLabel,
    v.artworkUrl,
    t1.typeSlug AS primaryType,
    t2.typeSlug AS secondaryType,
    l.method,
    l.level
FROM moveLearner l
JOIN variant v ON v.slug = l.variantSlug
LEFT JOIN variantType t1 ON t1.variantSlug = v.slug AND t1.slot = 1
LEFT JOIN variantType t2 ON t2.variantSlug = v.slug AND t2.slot = 2
WHERE l.moveSlug = ?
ORDER BY v.speciesDexNumber, v.sortOrder;

countMoveLearners:
SELECT count(*) FROM moveLearner;

insertMoveLearner:
INSERT INTO moveLearner(moveSlug, variantSlug, method, level) VALUES (?, ?, ?, ?);
