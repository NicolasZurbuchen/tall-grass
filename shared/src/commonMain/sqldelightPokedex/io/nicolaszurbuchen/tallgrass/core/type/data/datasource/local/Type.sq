-- The eighteen types, and the effectiveness chart between them.
CREATE TABLE type (
    slug       TEXT NOT NULL PRIMARY KEY,
    name       TEXT NOT NULL,
    generation INTEGER NOT NULL
);

-- A percentage, as upstream stores it: 0, 50, 200. Only non-neutral pairs are stored, so a missing
-- pair means neutral damage.
CREATE TABLE typeEfficacy (
    damageTypeSlug TEXT NOT NULL,
    targetTypeSlug TEXT NOT NULL,
    factorPercent  INTEGER NOT NULL,
    PRIMARY KEY (damageTypeSlug, targetTypeSlug)
);

countTypes:
SELECT count(*) FROM type;

countTypeEfficacies:
SELECT count(*) FROM typeEfficacy;

selectAllTypes:
SELECT * FROM type ORDER BY slug;

-- Projected rather than `SELECT *` so the generated row type is the query's own: `SELECT *` on
-- one table reuses the table class, which is named `TypeEfficacy` -- the same name as the domain
-- model the mapper converts to, in a file that would then have to alias one of the two.
selectEfficacyAgainst:
SELECT damageTypeSlug, factorPercent FROM typeEfficacy WHERE targetTypeSlug = ?;

insertType:
INSERT INTO type(slug, name, generation) VALUES (?, ?, ?);

insertTypeEfficacy:
INSERT INTO typeEfficacy(damageTypeSlug, targetTypeSlug, factorPercent) VALUES (?, ?, ?);
