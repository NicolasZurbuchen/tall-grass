-- One battle-distinct form of a species. Keyed by slug, which is upstream own identifier and what a
-- route keys on. listedInDex decides grid representation and nothing else.
CREATE TABLE variant (
    slug             TEXT NOT NULL PRIMARY KEY,
    speciesDexNumber INTEGER NOT NULL,
    speciesSlug      TEXT NOT NULL,
    name             TEXT NOT NULL,
    -- "Alolan", "Mega X", null for the ordinary form. Rendered as the card's chip.
    formLabel        TEXT,
    -- The raw upstream identifier: "alola", "mega-x", "gmax". An open set of 164 values, 134 of
    -- them used once, so it records what upstream said rather than anything queryable.
    form             TEXT,
    -- The closed taxonomy derived from it, which is what a screen filters on. See FormKind.kt.
    formKind         TEXT NOT NULL,
    isMega           INTEGER AS kotlin.Boolean NOT NULL,
    isBattleOnly     INTEGER AS kotlin.Boolean NOT NULL,
    isDefault        INTEGER AS kotlin.Boolean NOT NULL,
    listedInDex      INTEGER AS kotlin.Boolean NOT NULL,
    -- Decimetres and hectograms, upstream's units. Converted at the presentation edge.
    height           INTEGER NOT NULL,
    weight           INTEGER NOT NULL,
    -- What defeating this form is worth. Null for the 49 forms upstream has not costed yet, which
    -- is a different claim from a form worth nothing -- there is no such form.
    baseExperience   INTEGER,
    artworkUrl       TEXT NOT NULL,
    sortOrder        INTEGER NOT NULL
);

CREATE INDEX variantBySpecies ON variant(speciesDexNumber);
CREATE INDEX variantListedInDex ON variant(listedInDex);
CREATE INDEX variantByFormKind ON variant(formKind);

CREATE TABLE variantType (
    variantSlug TEXT NOT NULL,
    typeSlug    TEXT NOT NULL,
    slot        INTEGER NOT NULL,
    PRIMARY KEY (variantSlug, slot)
);

-- A form's figure against each of the six stats: what it has, and what defeating it awards.
--
-- The two live on one row because upstream keeps them on one row and they are read together. effort
-- is stored for all six rather than only where it is non-zero, unlike the JSON it is built from: the
-- row exists either way for the base stat, so a sparse column here would buy nothing and cost a
-- second table. A form upstream has not costed yet reads as zero against all six, which no filled-in
-- form ever does -- see PokemonDetailLocalMapper.
CREATE TABLE variantStat (
    variantSlug TEXT NOT NULL,
    statSlug    TEXT NOT NULL,
    baseStat    INTEGER NOT NULL,
    effort      INTEGER NOT NULL,
    PRIMARY KEY (variantSlug, statSlug)
);

CREATE TABLE variantAbility (
    variantSlug TEXT NOT NULL,
    abilitySlug TEXT NOT NULL,
    isHidden    INTEGER AS kotlin.Boolean NOT NULL,
    slot        INTEGER NOT NULL,
    PRIMARY KEY (variantSlug, slot)
);

-- The primary key leads with variantSlug, which covers a Pokemon asking what it has. An ability
-- asking who has it reads the table the other way and the key cannot answer that. Added now rather
-- than with the table because the ability detail is its first reader.
CREATE INDEX variantAbilityByAbility ON variantAbility(abilitySlug);

countVariants:
SELECT count(*) FROM variant;

countListedVariants:
SELECT count(*) FROM variant WHERE listedInDex = 1;

-- LEFT JOIN rather than a subquery per type column: SQLDelight infers a subquery column as NOT NULL,
-- and a single-type Pokemon has no second type. The primary key on (variantSlug, slot) keeps each
-- join to at most one row, so no card is duplicated.
selectDexEntries:
SELECT
    v.slug,
    v.speciesDexNumber,
    v.name,
    v.formLabel,
    v.artworkUrl,
    t1.typeSlug AS primaryType,
    t2.typeSlug AS secondaryType
FROM variant v
LEFT JOIN variantType t1 ON t1.variantSlug = v.slug AND t1.slot = 1
LEFT JOIN variantType t2 ON t2.variantSlug = v.slug AND t2.slot = 2
WHERE v.listedInDex = 1
ORDER BY v.speciesDexNumber, v.sortOrder;

selectVariantsBySpecies:
SELECT * FROM variant WHERE speciesDexNumber = ? ORDER BY sortOrder;

insertVariant:
INSERT INTO variant(slug, speciesDexNumber, speciesSlug, name, formLabel, form, formKind, isMega, isBattleOnly, isDefault, listedInDex, height, weight, baseExperience, artworkUrl, sortOrder)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertVariantType:
INSERT INTO variantType(variantSlug, typeSlug, slot) VALUES (?, ?, ?);

insertVariantStat:
INSERT INTO variantStat(variantSlug, statSlug, baseStat, effort) VALUES (?, ?, ?, ?);

insertVariantAbility:
INSERT INTO variantAbility(variantSlug, abilitySlug, isHidden, slot) VALUES (?, ?, ?, ?);

-- Every form of one species, for the detail screen's form switcher. The two type joins are the same
-- shape as selectDexEntries and are LEFT for the same reason: a subquery would be typed NOT NULL.
selectVariantDetails:
SELECT
    v.slug,
    v.name,
    v.formLabel,
    v.formKind,
    v.isDefault,
    v.height,
    v.weight,
    v.baseExperience,
    v.artworkUrl,
    t1.typeSlug AS primaryType,
    t2.typeSlug AS secondaryType
FROM variant v
LEFT JOIN variantType t1 ON t1.variantSlug = v.slug AND t1.slot = 1
LEFT JOIN variantType t2 ON t2.variantSlug = v.slug AND t2.slot = 2
WHERE v.speciesDexNumber = ?
ORDER BY v.sortOrder;

-- Six rows per variant, read for the whole species in one go rather than per form: switching form
-- must not hit the database, because the switch is what the transition between forms animates.
selectStatsBySpecies:
SELECT vs.variantSlug, vs.statSlug, vs.baseStat, vs.effort
FROM variantStat vs
JOIN variant v ON v.slug = vs.variantSlug
WHERE v.speciesDexNumber = ?;
