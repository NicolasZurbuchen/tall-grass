-- One battle-distinct form of a species: the thing that owns stats, types, abilities and artwork.
--
-- Keyed by slug, taken straight from upstream -- `vulpix`, `vulpix-alola`, `charizard-mega-x`.
-- Not invented and not hand-maintained, which is what makes it safe to put in a route.
--
-- listedInDex decides grid representation and nothing else. Only regional forms get a card of their
-- own; Megas, alternate forms, battle-only transformations, fusions and gender-distinct variants are
-- all full rows here but are reached through the detail screen's form switcher. Cosmetic-only forms
-- are not variants at all and never reach this table.
CREATE TABLE variant (
    slug             TEXT NOT NULL PRIMARY KEY,
    speciesDexNumber INTEGER NOT NULL,
    name             TEXT NOT NULL,
    -- "Alolan", "Mega X", null for the ordinary form. Rendered as the card's chip.
    formLabel        TEXT,
    -- 0 or 1. SQLite has no boolean, and mapping it here would need a column adapter wired
    -- identically in two modules; the domain mapper converts once instead.
    isDefault        INTEGER NOT NULL,
    listedInDex      INTEGER NOT NULL,
    -- Decimetres and hectograms, upstream's units. Converted at the presentation edge.
    height           INTEGER NOT NULL,
    weight           INTEGER NOT NULL,
    artworkUrl       TEXT NOT NULL,
    sortOrder        INTEGER NOT NULL
);

CREATE INDEX variantBySpecies ON variant(speciesDexNumber);
CREATE INDEX variantListedInDex ON variant(listedInDex);

CREATE TABLE variantType (
    variantSlug TEXT NOT NULL,
    typeSlug    TEXT NOT NULL,
    slot        INTEGER NOT NULL,
    PRIMARY KEY (variantSlug, slot)
);

CREATE TABLE variantStat (
    variantSlug TEXT NOT NULL,
    statSlug    TEXT NOT NULL,
    baseStat    INTEGER NOT NULL,
    PRIMARY KEY (variantSlug, statSlug)
);

CREATE TABLE variantAbility (
    variantSlug TEXT NOT NULL,
    abilitySlug TEXT NOT NULL,
    abilityName TEXT NOT NULL,
    isHidden    INTEGER NOT NULL,
    slot        INTEGER NOT NULL,
    PRIMARY KEY (variantSlug, slot)
);

countVariants:
SELECT count(*) FROM variant;

countListedVariants:
SELECT count(*) FROM variant WHERE listedInDex = 1;

-- The dex grid, in National Dex order with a species own forms adjacent.
--
-- LEFT JOIN rather than a correlated subquery for each type, which is what this started as. The
-- primary key on (variantSlug, slot) means each join still matches at most one row, so no card is
-- duplicated -- but SQLDelight infers a subquery column as NOT NULL and a left-joined one as
-- nullable. The subquery version therefore typed secondaryType as String and threw on the first
-- single-type Pokemon, which is most of them.
selectDexEntries:
SELECT
    v.slug,
    v.speciesDexNumber,
    v.name,
    v.formLabel,
    v.artworkUrl,
    t1.typeSlug AS primaryType,
    t2.typeSlug AS secondaryType
FROM variant v
LEFT JOIN variantType t1 ON t1.variantSlug = v.slug AND t1.slot = 1
LEFT JOIN variantType t2 ON t2.variantSlug = v.slug AND t2.slot = 2
WHERE v.listedInDex = 1
ORDER BY v.speciesDexNumber, v.sortOrder;

selectVariantsBySpecies:
SELECT * FROM variant WHERE speciesDexNumber = ? ORDER BY sortOrder;

insertVariant:
INSERT INTO variant(slug, speciesDexNumber, name, formLabel, isDefault, listedInDex, height, weight, artworkUrl, sortOrder)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertVariantType:
INSERT INTO variantType(variantSlug, typeSlug, slot) VALUES (?, ?, ?);

insertVariantStat:
INSERT INTO variantStat(variantSlug, statSlug, baseStat) VALUES (?, ?, ?);

insertVariantAbility:
INSERT INTO variantAbility(variantSlug, abilitySlug, abilityName, isHidden, slot) VALUES (?, ?, ?, ?, ?);
